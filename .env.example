GEMINI_API_KEY=your_gemini_api_key_here

# GCP Project ID for Vertex AI batch inference (required for pipeline)
GCP_PROJECT_ID=your_gcp_project_id_here

# Optional: GCS configuration for video storage with retention
# GCS_BUCKET=your-gcs-bucket-name
# GCS_RETENTION_HOURS=1

# Security: Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# SECRET_KEY=your_secret_key_here

# DEBUG must never be enabled in production. Set to 'true' only for local development.
DEBUG=true

# Host to bind to:
#   - localhost (127.0.0.1): Only accessible from the same machine (default for security)
#   - 0.0.0.0: Accessible from any machine on the network (required for remote access)
# For deployment on a server accessible from other machines, use 0.0.0.0
HOST=localhost

# Port to run the application on
PORT=5000

# Session cookie security (set to true in production with HTTPS)
# SESSION_COOKIE_SECURE=true

# Multi-user mode configuration
# When enabled, each user session has its own video folder setting stored in the session.
# This allows multiple users to work with different video folders simultaneously without conflicts.
# When disabled (default), the video folder setting is global and shared by all users.
# Set to 'true' for multi-user deployments where users need isolation.
# MULTI_USER_MODE=true

# Semantic search configuration
# The limit and similarity threshold for semantic results only.
# SEMANTIC_SEARCH_LIMIT=5
# SEMANTIC_SEARCH_THRESHOLD=0.65
